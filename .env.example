# --- required for the real demo (free AI Studio key works for every model Rakshak uses) ---
GEMINI_API_KEY=
# --- or use Agent Platform / Vertex endpoints with the $300 trial credits ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=asia-southeast1

# --- optional Google Cloud data services (local JSON fallbacks are used when unset) ---
# BIGQUERY_PAYEE_TABLE=your-project.rakshak.payee_risk
# USE_FIRESTORE=true
# PUBSUB_ALERT_TOPIC=rakshak-alerts

# --- optional telephony bridge (judge calls a real number) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# TWILIO_DIAL_NUMBER=+91...        # the 'scammer' phone Twilio dials
# PUBLIC_BASE_URL=https://xxxx.ngrok.app

# --- behaviour ---
# RAKSHAK_HOLD_MINUTES=30
# RAKSHAK_FAKE_LLM=1               # offline keyword stub (tests / no-network demo)
# RAKSHAK_PREWARM_TTS=1
# RAKSHAK_RETAIN_AUDIO=false
